<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>6c775d27-a1c5-4012-818f-b2cbaa886efd</UserSecretsId>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Templete\EmailConfirmation.html" />
	  <None Remove="Templete\ResetPassword.html" />
	  <None Remove="Templete\Welcome.html" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="Templete\EmailConfirmation.html">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Templete\ResetPassword.html">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Templete\Welcome.html">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Hangfire" Version="1.8.23" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
		<PackageReference Include="Hangfire.SqlServer" Version="1.8.23" />
		<PackageReference Include="MailKit" Version="4.16.0" />
		<PackageReference Include="MimeKit" Version="4.16.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<!-- pins the transitive MimeKit dependency to a patched version (C0: GHSA-846f-f764-76mx / CVE-2026-84008); aligned with the .NET 10 framework -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WazzufJobs.BLL\WazzufJobs.BLL.csproj" />
		<ProjectReference Include="..\WazzufJobs.DAL\WazzufJobs.DAL.csproj" />
		<ProjectReference Include="..\WazzufJobs.Shared\WazzufJobs.Shared.csproj" />
	</ItemGroup>
</Project>