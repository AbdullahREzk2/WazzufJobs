{
  "rewrites": [
    { "source": "/api/headers", "destination": "https://httpbin.org/headers" },
    { "source": "/api/set-cookie", "destination": "https://httpbin.org/response-headers?Set-Cookie=__Host-wz_probe%3D1%3B%20Path%3D%2F%3B%20Secure%3B%20HttpOnly%3B%20SameSite%3DStrict" },
    { "source": "/api/cookies", "destination": "https://httpbin.org/cookies" },
    { "source": "/api/upload", "destination": "https://httpbin.org/status/200" },
    { "source": "/api/delay", "destination": "https://httpbin.org/delay/10" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
